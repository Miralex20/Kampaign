{
  "name": "campaign-messaging",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @campaign/web dev",
    "db:start": "tsx --env-file=.env scripts/start-local-db.ts",
    "db:migrate": "pnpm --filter @campaign/db db:migrate",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "worker": "pnpm --filter @campaign/worker start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/pg": "8.11.14",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.28.0",
    "eslint-plugin-import-x": "4.15.2",
    "pg": "8.16.0",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
