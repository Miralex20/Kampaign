# =============================================================================
# Campaign Messaging — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (connect via PgBouncer port 5433 in dev, 5432 in test)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://campaign:campaign_dev@localhost:5433/campaign_db
DATABASE_TEST_URL=postgres://campaign:campaign_dev@localhost:5432/campaign_test_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Public landing page domain — serves /m/[token] routes
LINK_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# listmonk
# -----------------------------------------------------------------------------
LISTMONK_BASE_URL=http://localhost:9000
LISTMONK_API_USER=api_user
LISTMONK_API_TOKEN=your_listmonk_api_token_here
# ID of the transactional template created in listmonk UI (Campaigns → Templates)
LISTMONK_TX_TEMPLATE_ID=1
# Number of parallel /api/tx calls per worker process
LISTMONK_DISPATCH_CONCURRENCY=10

# -----------------------------------------------------------------------------
# Token security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must decode to exactly 32 bytes (256 bits).
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# -----------------------------------------------------------------------------
# Auth.js & Superadmin Configuration
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
AUTH_SECRET=REPLACE_WITH_AUTH_SECRET
# Comma-separated list of emails automatically elevated to superadmin on login/provision
SUPERADMIN_EMAILS=superadmin@yourdomain.com,owner@yourdomain.com

# -----------------------------------------------------------------------------
# Production SMTP / Magic Link Email Delivery
# -----------------------------------------------------------------------------
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=re_123456789
EMAIL_FROM="Campaign Platform <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# Webhook signature secret (shared with listmonk webhook config)
# -----------------------------------------------------------------------------
EMAIL_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# Sending limits
# -----------------------------------------------------------------------------
NEW_ORG_DAILY_CAP=500

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Node environment
# -----------------------------------------------------------------------------
NODE_ENV=development
